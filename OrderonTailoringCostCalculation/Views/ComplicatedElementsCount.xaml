<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderonTailoringCostCalculation.Views.ComplicatedElementsCount"
             xmlns:viewModels="clr-namespace:OrderonTailoringCostCalculation.ViewModels"
             x:DataType="viewModels:ComplicatedElementsCountViewModel"
             Title="Введите количество элементов">
    
    <Border HorizontalOptions="Center" VerticalOptions="Center">
        <StackLayout>
            <Label Text="{Binding DisplayComplicatedElementName}"/>
            <Stepper Increment="1" Value="{Binding CurrentElementsCount}"/>
            <Entry Text="{Binding CurrentElementsCount, Mode=TwoWay}"/>
            <Button Text="Сохранить" Command="{Binding CountSelectedCommand}"/>
        </StackLayout>
    </Border>
</ContentPage>