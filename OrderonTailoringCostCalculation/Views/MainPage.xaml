<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:models="clr-namespace:OrderonTailoringCostCalculation.Models"
             xmlns:viewModels="clr-namespace:OrderonTailoringCostCalculation.ViewModels"
             x:Class="OrderonTailoringCostCalculation.Views.MainPage"
             x:DataType="viewModels:ReceiptsViewModel"
             Title="Чеки">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackLayout Grid.Row="0" Orientation="Horizontal">
            <Button Text="Создать чек" Command="{Binding GoToReceiptCommand}"/>
            <Button Text="Редактировать чек" Command="{Binding GoToReceiptWithParamCommand}"
        CommandParameter="{Binding SelectedReceipt}"/>
        </StackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels: ReceiptListItemViewModel">
                    <Grid>
                        <Border>
                            <StackLayout Orientation="Vertical">

                                <Label Text="{Binding DisplayMinValueGarmentName, StringFormat='Наименование: {0}'}"/>

                                <Label Text="{Binding minValue, StringFormat='Минимальная стоимость: {0} ₽'}"/>

                                <Label Text="{Binding complicatedElementsValue, StringFormat='Стоимость усложняющих элементов: {0} ₽'}"/>

                                <Label Text="{Binding discountValue, StringFormat='Сумма скидок/надбавок: {0} ₽'}"/>

                                <Label Text="{Binding totalValue, StringFormat='Общая стоимость: {0} ₽'}"/>

                            </StackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>