<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:models="clr-namespace:OrderonTailoringCostCalculation.Models"
             xmlns:viewModels="clr-namespace:OrderonTailoringCostCalculation.ViewModels"
             x:Class="OrderonTailoringCostCalculation.Views.MainPage"
             x:DataType="viewModels:ReceiptsViewModel"
             Title="Чеки">

    <CollectionView ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}">
        <CollectionView.Header>
            <StackLayout Orientation="Horizontal">
                <Button Text="Создать чек" Command="{Binding GoToReceiptCommand}"/>
                <Button Text="Редактировать чек" Command="{Binding GoToReceiptWithParamCommand}"
                        CommandParameter="{Binding SelectedReceipt}"/>
            </StackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="viewModels: ReceiptListItemViewModel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Text="Наименование: "/>
                    <Label Grid.Column="1" Grid.Row="0" Text="{Binding DisplayMinValueGarmentName}"/>
                    
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>