<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:OrderonTailoringCostCalculation.ViewModels"
             x:Class="OrderonTailoringCostCalculation.Views.ReceiptPage"
             x:DataType="viewModels:ReceiptDetailsViewModel"
             Title="Чек">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Text="{Binding DisplayMinValueGarmentName}"/>
        <Button Grid.Row="0" Grid.Column="1" Text="Добавить\Изменить основу изделия" Command="{Binding GoToGarmentsCommand}" LineBreakMode="WordWrap"/>
        <Button Grid.Row="1" Grid.Column="0" Text="Сохранить" Command="{Binding SaveReceiptCommand}"/>
    </Grid>
    
</ContentPage>